# Copy this file to .env and fill in real values before running.
# .env is gitignored — never commit actual secrets.

# ── JWT ───────────────────────────────────────────────────────────────────
# Minimum 32 characters (256 bits) for HMAC-SHA256.
JWT_SECRET=replace-with-a-long-random-secret-minimum-32-chars

# ── TLS keystore ──────────────────────────────────────────────────────────
# Must match the password used when the keystore was generated.
SSL_KEY_STORE_PASSWORD=formforge

# ── PostgreSQL ────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/formforge
DB_USERNAME=formforge
DB_PASSWORD=replace-with-db-password

# ── MongoDB ───────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/formforge_chat
